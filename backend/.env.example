# Copy to backend/.env for local development. Every setting is a GOBERNAR360_* variable;
# see src/gobernar360/core/config.py for all of them and their defaults.

# Links in emails and the single sign-on callback point here.
GOBERNAR360_APP_URL=http://localhost:5173

# Outgoing email: the mail catcher of docker-compose.yml (web inbox at http://localhost:8025).
GOBERNAR360_SMTP_HOST=localhost
GOBERNAR360_SMTP_PORT=1025
GOBERNAR360_SMTP_SECURITY=none
GOBERNAR360_EMAIL_FROM=gobernar360 <no-reply@gobernar360.test>

# Single sign-on through the local OpenID Connect provider of docker-compose.yml.
# Leave GOBERNAR360_OIDC_ISSUER empty to turn single sign-on off.
GOBERNAR360_OIDC_ISSUER=http://localhost:5556
GOBERNAR360_OIDC_CLIENT_ID=gobernar360
GOBERNAR360_OIDC_CLIENT_SECRET=gobernar360-dev-secret
